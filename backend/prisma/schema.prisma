datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Lote {
  id              String   @id @default(uuid())
  codigo          String   @unique
  produto         String
  qualidade       String?  @default("Tipo 2")
  proprietario    String?  @default("Fazenda União")
  quantidade      Int      @default(1000)
  status          String   @default("AGUARDANDO_DESCARGA")
  criadoEm        DateTime @default(now())
}

model Empilhadeira {
  id           String   @id @default(uuid())
  nome         String
  operador     String?  @default("Operador Responsável")
  capacidadeKg Int      @default(2500)
  status       String   @default("DISPONIVEL")
  criadoEm     DateTime @default(now())
}
