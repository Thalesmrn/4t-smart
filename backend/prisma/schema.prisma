generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Lote {
  id           String   @id @default(uuid())
  codigo       String   @unique
  produto      String
  qualidade    String   @default("Tipo 2")
  proprietario String   @default("Fazenda União")
  quantidade   Int
  status       String   @default("AGUARDANDO_DESCARGA")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Empilhadeira {
  id           String   @id @default(uuid())
  nome         String
  operador     String
  capacidadeKg Int      @default(2500)
  status       String   @default("DISPONIVEL")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Tarefa {
  id             String   @id @default(uuid())
  descricao      String
  tipo           String   @default("MOVIMENTACAO")
  prioridade     Int      @default(1)
  status         String   @default("PENDENTE")
  empilhadeiraId String?
  origem         String?
  destino        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
