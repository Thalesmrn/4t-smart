generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Galpao {
  id         String   @id @default(uuid())
  nome       String
  codigo     String   @unique
  capacidade Int      @default(1000)
  posicoes   Posicao[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Posicao {
  id        String   @id @default(uuid())
  codigo    String   @unique
  status    String   @default("DISPONIVEL") // DISPONIVEL, OCUPADA, BLOQUEADA
  galpaoId  String?
  galpao    Galpao?  @relation(fields: [galpaoId], references: [id])
  loteId    String?
  lote      Lote?    @relation(fields: [loteId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lote {
  id           String    @id @default(uuid())
  codigo       String    @unique
  produto      String
  qualidade    String?   // <-- Campo adicionado
  proprietario String?   // <-- Campo adicionado
  quantidade   Int
  status       String    @default("DISPONIVEL")
  posicoes     Posicao[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Tarefa {
  id             String   @id @default(uuid())
  descricao      String
  tipo           String
  prioridade     Int
  status         String   @default("PENDENTE")
  empilhadeiraId String?
  origem         String?
  destino        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Empilhadeira {
  id            String  @id @default(uuid())
  identificador String  @unique
  operador      String?
  status        String  @default("DISPONIVEL")
  bateria       Int     @default(100)
}
